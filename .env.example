# PTA app: Vite SPA + Vercel Serverless Functions.
# CRM list endpoint URL matches a Next.js-style path: GET /api/crm/reports (implemented as api/crm/reports.ts on Vercel).

# --- Vite client (Firebase Web SDK) — copy to .env.local ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Public app origin for CRM deep links (HTTPS, no trailing slash) ---
# Used by GET /api/crm/reports to build viewUrl and embedUrl, and should match the browser origin for Firebase Auth.
# On Vercel you can omit this if VERCEL_URL is enough; set explicitly for production domain / www.
NEXT_PUBLIC_APP_URL=https://your-pta-app.vercel.app

# --- CRM embed (/embed/:id and /embed/reports/:id) ---
# Firebase Console → Authentication → Sign-in method: enable Anonymous. The embed page signs in anonymously
# so Firestore rules (read: if request.auth != null) allow loading a report inside a CRM iframe.
# Iframe framing: vercel.json sets CSP frame-ancestors * for /embed/*. Tighten in Vercel Dashboard → Headers if needed.

# --- CRM → PTA integration (server-side only; never expose as VITE_*) ---
# If set (recommended in production), requests must send: Authorization: Bearer <same value>
# If unset, the list route allows unauthenticated access (convenient for local dev only).
CRM_PTA_API_KEY=

# Firebase Admin — required for /api/crm/reports to read Firestore (bypasses client auth rules).
# On Vercel: paste the full JSON of a service account key (Project settings → Service accounts).
# Local: you can use GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json instead.
FIREBASE_SERVICE_ACCOUNT_JSON=
